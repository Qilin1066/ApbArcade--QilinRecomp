# A missing/truncated trace must never become a successful independent check.
file(MAKE_DIRECTORY "${OUT}")
function(check_trace name text expected)
    file(WRITE "${OUT}/${name}.trace" "${text}")
    file(REMOVE "${OUT}/${name}.wav")
    execute_process(COMMAND "${PROGRAM}" "${OUT}/${name}.trace" "${OUT}/${name}.wav" 559
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "${name}: expected exit ${expected}, got ${result}")
    endif()
    if(expected EQUAL 0)
        file(SIZE "${OUT}/${name}.wav" bytes)
        if(NOT bytes EQUAL 2276)
            message(FATAL_ERROR "Wrong resampled WAV size ${bytes}")
        endif()
    elseif(EXISTS "${OUT}/${name}.wav")
        message(FATAL_ERROR "Invalid trace wrote a WAV")
    endif()
endfunction()
check_trace(valid "w 187E FF 0\n# end 100000\n" 0)
check_trace(truncated "w 187E FF 0\n" 1)
check_trace(short "w 187E FF 0\n# end 10\n" 1)
check_trace(reversed "w 187E FF 100\nw 187E 00 99\n# end 100000\n" 1)
check_trace(malformed "w 187E FF junk\n# end 100000\n" 1)
check_trace(address "w 0000 FF 0\n# end 100000\n" 1)
check_trace(after_end "w 187E FF 0\n# end 100000\nw 187E 00 1\n" 1)
